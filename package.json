{
  "name": "country-phone-mask",
  "version": "1.9.2",
  "description": "Phone input with country selector and number masking (now using ipinfo.io for geo detection)",
  "keywords": [
    "phone",
    "mask",
    "country",
    "input",
    "geo"
  ],
  "license": "ISC",
  "author": "Filippov Vladislav",
  "style": "dist/index.css",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "rollup -c",
    "sprite": "node scripts/generate-sprite.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-url": "^3.0.1",
    "sass": "^1.89.0",
    "svg-sprite": "^2.0.4",
    "tslib": "^2.8.1",
    "typescript": "^5.2.2",
    "vite": "^6.3.5"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "types/"
  ]
}
